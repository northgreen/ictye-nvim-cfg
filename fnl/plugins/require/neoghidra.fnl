{
  1 "B00TK1D/neoghidra"
    :opts {
      :ghidra_path  "/opt/ghidra"
      :auto_analyze  true
      :default_view  "decompiler"
      :keymaps  {
        :toggle_view  "<leader>gt"
        :goto_definition  "gd"
        :rename_symbol  "<leader>gr"
        :jump_to_offset  "<leader>go"
        :list_functions  "<leader>gF"
      }
    }
}
