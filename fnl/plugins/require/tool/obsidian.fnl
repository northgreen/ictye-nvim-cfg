{1 "obsidian-nvim/obsidian.nvim"
 ;; Recommended: use latest release instead of latest commit.
 :version "*"
 :ft "markdown"
 ;; Module obsidian; opts: obsidian.config.
 :opts {;; This will be removed in the next major release.
        :legacy_commands false
        :workspaces [{:name "personal" :path "~/Documents/Notes"}]}}
